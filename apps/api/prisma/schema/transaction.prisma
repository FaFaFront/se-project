enum TransactionType {
  topup
  session_charge
  earning
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  type             TransactionType
  amount           Decimal         @db.Decimal(12, 2) // sign implied by type
  relatedSessionId String?
  note             String?
  createdAt        DateTime        @default(now())

  user           User         @relation(fields: [userId], references: [id])
  relatedSession MeetSession? @relation(fields: [relatedSessionId], references: [id])

  @@index([userId, createdAt])
  @@map("transactions")
}
