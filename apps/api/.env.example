# Database Configuration (Supabase)
# Get the connection string from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the "Direct connection" string for migrations and the "Transaction pooler" (port 6543) for app runtime.
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Server Configuration
PORT=4000
CORS_ORIGIN=http://localhost:3000
CHECKPOINT_DISABLE=1

# JWT Authentication
# Replace with a long random string in production (e.g. openssl rand -base64 64)
JWT_SECRET=replace-with-a-long-random-secret

# Native Redis connection used by Socket.IO for cross-instance room broadcasts.
# Local development may omit it and use the in-memory adapter.
# Production requires a TLS URL and authentication from the Redis provider.
REDIS_URL=rediss://default:password@host:port

# Google Cloud Platform (project that owns the service account and Cloud Storage bucket)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Cloud Storage bucket used for uploads/assets
GOOGLE_STORAGE_BUCKET=your-bucket-name

# Cloud Storage credentials. Keep JSON keys outside this repository.
GOOGLE_STORAGE_CREDENTIALS_PATH=/absolute/path/to/google-storage.json
# For production/CI, the full JSON can instead be stored as a single-line secret.
# GOOGLE_STORAGE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Google Meet REST API v2
# Local interactive OAuth option: use an OAuth Desktop/Web client JSON file.
# The first Meet call opens a browser for authorization. This takes precedence
# over service-account settings and is intended only for local development.
# Web OAuth clients require a localhost redirect URI; stop the web dev server if
# that URI uses port 3000 while completing authorization.
GOOGLE_MEET_OAUTH_CREDENTIALS_PATH=/absolute/path/to/oauth-client.json

# Unattended server option: Google Workspace service-account delegation.
# 1. In the Google Cloud project, enable "Google Meet REST API".
# 2. Create a service account, enable domain-wide delegation, create a JSON key,
#    and copy its numeric OAuth 2 Client ID.
# 3. As a Google Workspace super admin, open Admin console -> Security ->
#    Access and data control -> API controls -> Manage Domain Wide Delegation.
#    Add the service account Client ID with these comma-separated OAuth scopes:
#    https://www.googleapis.com/auth/meetings.space.created,https://www.googleapis.com/auth/meetings.space.readonly
# 4. Set GOOGLE_MEET_IMPERSONATE_USER to an active user in the same Workspace
#    domain. This user becomes the meeting organizer/host. Personal Gmail
#    accounts cannot be used for this domain-wide delegation flow.
GOOGLE_MEET_IMPERSONATE_USER=meet-host@example.com

# Local development (recommended): download the service-account JSON key, store
# it OUTSIDE the repository, and put its absolute path here. On Windows, either
# forward slashes or escaped backslashes work, for example:
# GOOGLE_MEET_CREDENTIALS_PATH=C:/Users/your-name/.config/gcp/google-meet.json
GOOGLE_MEET_CREDENTIALS_PATH=/absolute/path/to/google-meet.json

# Production/CI alternative: leave GOOGLE_MEET_CREDENTIALS_PATH empty and set
# the full service-account JSON as a single-line secret. If both are set, the
# inline value takes precedence. Never commit the real value.
# GOOGLE_MEET_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
