{
  "name": "se-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "yarn workspace web dev",
    "web:build": "yarn workspace web build",
    "web:storybook": "yarn workspace web storybook",
    "web:build-storybook": "yarn workspace web build-storybook",
    "api:dev": "yarn workspace api dev",
    "api:build": "yarn workspace api build",
    "test": "yarn workspace api test && yarn workspace web test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:check": "tsc --project tests/tsconfig.json",
    "test:e2e:db": "docker compose -f compose.e2e.yml up -d --wait",
    "test:e2e:db:stop": "docker compose -f compose.e2e.yml stop",
    "db:create": "yarn workspace api db.create",
    "db:start": "yarn workspace api db.start",
    "db:stop": "yarn workspace api db.stop",
    "db:down": "yarn workspace api db.down",
    "db:generate": "yarn workspace api db.generate",
    "db:push": "yarn workspace api db.push",
    "db:studio": "yarn workspace api db.studio",
    "db:migrate": "yarn workspace api db.migrate",
    "db:seed": "yarn workspace api db.seed"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.65.0",
    "@prisma/client": "^6.1.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "next": "^16.3.8",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  },
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.0",
    "qs": "6.16.2",
    "swagger-jsdoc/glob": "^14.0.4",
    "@apidevtools/swagger-parser/@apidevtools/json-schema-ref-parser": "^15.5.2"
  },
  "overrides": {
    "qs": "6.16.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.17.0"
}
